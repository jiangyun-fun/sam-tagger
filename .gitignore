# pixi — the lockfile IS committed for reproducible CI; only the local env is ignored.
.pixi/

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.pyright/

# editor / os
.DS_Store
*~

# quarto — rendered HTML + its resource dirs are build artifacts; commit the .qmd source only
docs/*.html
docs/*_files/
docs/plans/*.html
docs/plans/*_files/
